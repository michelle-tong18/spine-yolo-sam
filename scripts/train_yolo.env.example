# Local machine / cluster settings for the sample_*.sh scripts.
#
# Copy once (do not commit the copy if it contains a W&B key):
#   cp train_yolo.env.example my_vars.env   (from scripts/)
#
# The sample scripts source my_vars.env from the directory you run them in
# (typically scripts/). You can also load it in an interactive shell:
#   source my_vars.env

# --- Python environment ---
# Either a conda prefix (directory that contains bin/python):
#   CONDA_ENV_NAME=/opt/conda/envs/spine-yolo-sam
# or a named env if `conda` is on your PATH:
#   CONDA_ENV_NAME=spine-yolo-sam
# Leave unset if you already `conda activate` / `source .venv/bin/activate`.
CONDA_ENV_NAME=/path/to/your/conda_env

# Scratch dir for W&B caches and temp files. Optional but useful on shared clusters.
TMP_DIR=/path/to/your/tmp

export CONDA_ENV_NAME
export TMP_DIR

# --- Weights & Biases (optional) ---
# Needed for YOLO hyperparameter sweeps and if SAM.module.use_wandb is True.
# Leave as placeholders (or comment out) to train without W&B.
export WANDB_API_KEY=your_wandb_api_key
export WANDB_ENTITY=your_wandb_entity
# export WANDB_PROJECT=spine-yolo-sam

# If TMP_DIR is a real path, the scripts also set WANDB_DIR / CACHE / CONFIG there.
export WANDB_DIR=$TMP_DIR
export WANDB_CACHE_DIR=$TMP_DIR
export WANDB_CONFIG_DIR=$TMP_DIR

# Uncomment to force-disable W&B even if a key is set:
# export WANDB_MODE=disabled
